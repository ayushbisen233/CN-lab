/*
 * Practical 2: TCP Server (Socket Creation, Bind, Listen, Accept)
 * -------------------------------------------------------------
 * Description:
 *   Creates a TCP socket, binds to port 10001, listens for an incoming
 *   connection, and accepts the client connection.
 *
 * Requirements:
 *   Linux / WSL terminal (uses POSIX socket headers: <arpa/inet.h>, <unistd.h>)
 *
 * How to Run:
 *   1. Compile:
 *      gcc -x c p2 -o p2
 *      (or if renamed with .c: gcc p2.c -o p2)
 *
 *   2. Run the server (Terminal 1):
 *      ./p2
 *
 *   3. Connect a client to test (Terminal 2):
 *      nc 127.0.0.1 10001
 *      (or: telnet 127.0.0.1 10001)
 */

#include <arpa/inet.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define PORT 10001

int main() {
  int sockfd, new_sock;
  struct sockaddr_in server_addr, client_addr;
  socklen_t len = sizeof(client_addr);

  sockfd = socket(AF_INET, SOCK_STREAM, 0);

  if (sockfd < 0) {
    printf("Socket creation failed\n");
    return -1;
  }

  server_addr.sin_family = AF_INET;
  server_addr.sin_addr.s_addr = INADDR_ANY;
  server_addr.sin_port = htons(PORT);

  if (bind(sockfd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
    printf("Bind failed\n");
    return -1;
  }

  listen(sockfd, 5);
  printf("TCP Server listening...\n");

  new_sock = accept(sockfd, (struct sockaddr *)&client_addr, &len);

  if (new_sock < 0) {
    printf("Accept failed\n");
    return -1;
  }

  printf("Client connected successfully\n");

  close(new_sock);
  close(sockfd);

  return 0;
}
